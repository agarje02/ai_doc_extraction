# ---- LLM provider selection ----
# One of: mock | openai | anthropic | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Provider credentials / endpoints ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- OCR ----
# Path to the tesseract binary. Leave blank to use the system PATH.
TESSERACT_CMD=
# Path to the poppler "bin" dir (Windows) for pdf2image. Leave blank on Linux/macOS.
POPPLER_PATH=
# Render scanned/image PDFs to images and OCR them when native text is sparse.
OCR_ENABLED=true
# If a page has fewer than this many characters of native text, fall back to OCR.
OCR_MIN_CHARS=20

# ---- Chunking ----
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=150

# ---- Confidence ----
# Fields below this score are flagged for human review in the UI.
CONFIDENCE_REVIEW_THRESHOLD=0.6

# ---- Storage ----
# Default: local SQLite (zero setup).
DATABASE_URL=sqlite:///./ai_doc_extraction.db
# PostgreSQL / Supabase: paste the connection string from Supabase
# (Project Settings -> Database -> Connection string -> URI). Either form works;
# a bare postgres:// URL is auto-upgraded to the psycopg driver. Install the
# driver first: pip install "psycopg[binary]"  (or: pip install .[postgres])
# For serverless/edge, prefer Supabase's port 6543 pooler URL.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
STORAGE_DIR=./storage

# ---- API ----
CORS_ORIGINS=http://localhost:3000
